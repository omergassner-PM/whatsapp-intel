# ===========================================
# WhatsApp Group Intelligence Platform
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Database ---
POSTGRES_DB=whatsapp_intel
POSTGRES_USER=intel
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Constructed automatically in docker-compose, set manually for local dev:
# DATABASE_URL=postgresql://intel:password@localhost:5432/whatsapp_intel

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# --- Processing ---
# Claude model for article processing
LLM_MODEL=claude-sonnet-4-20250514

# Timeout for web scraping in seconds
SCRAPE_TIMEOUT=30

# --- Webapp ---
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
